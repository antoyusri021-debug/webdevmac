{
  "name": "Webdev",
  "version": "1.7.5",
  "description": "Overlay Stream Pro",
  "main": "main.js",
  "author": "webdev",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.webdev.sync",
    "productName": "WebDev",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "antoyusri021-debug",
        "repo": "WebDev-Stream-Sync"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "webdev.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebDev Sync",
      "installerIcon": "webdev.ico",
      "uninstallerIcon": "webdev.ico",
      "installerHeaderIcon": "webdev.ico",
      "installerSidebar": "sidebar.bmp",
      "license": "SAMBUTAN.txt",
      "installerLanguages": [
        "id_ID"
      ],
      "language": "1057"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "title": "${productName} - ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 220,
          "type": "file"
        }
      ]
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.99.0",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "google-tts-api": "^2.0.2",
    "groq-sdk": "^1.3.0",
    "msedge-tts": "^2.0.7",
    "node-machine-id": "^1.1.12",
    "ping": "^1.0.0",
    "play-dl": "^1.9.7",
    "socket.io": "^4.7.2",
    "systeminformation": "^5.31.7",
    "tiktok-live-connector": "^2.1.1-beta1",
    "ws": "^8.21.0",
    "youtube-search-api": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1"
  }
}