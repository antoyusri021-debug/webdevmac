{
  "name": "webdev",
  "version": "1.4.0",
  "description": "Overlay Stream Sync",
  "main": "main.js",
  "author": "webdev",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build-all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.webdev.sync",
    "productName": "WebDev",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools",
      "icon": "webdev.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "webdev.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebDev Sync",
      "installerIcon": "webdev.ico",
      "uninstallerIcon": "webdev.ico",
      "installerHeaderIcon": "webdev.ico",
      "installerSidebar": "sidebar.bmp",
      "license": "SAMBUTAN.txt",
      "installerLanguages": ["id_ID"],
      "language": "1057"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "express": "^4.18.2",
    "node-machine-id": "^1.1.12",
    "socket.io": "^4.7.2",
    "tiktok-live-connector": "^2.1.1-beta1"
  },
  "devDependencies": {
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1"
  }
}