{
  "name": "Webdev",
  "version": "1.7.2",
  "description": "Overlay Stream Sync",
  "main": "main.js",
  "author": "webdev",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.webdev.sync",
    "productName": "WebDev",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/mac-icon.icns"
    },
    "dmg": {
      "title": "Install WebDev Sync"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "webdev.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebDev Sync",
      "installerIcon": "webdev.ico",
      "uninstallerIcon": "webdev.ico",
      "installerHeaderIcon": "webdev.ico",
      "installerSidebar": "sidebar.bmp",
      "license": "SAMBUTAN.txt",
      "installerLanguages": [
        "id_ID"
      ],
      "language": "1057"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "express": "^4.18.2",
    "node-machine-id": "^1.1.12",
    "ping": "^1.0.0",
    "play-dl": "^1.9.7",
    "socket.io": "^4.7.2",
    "systeminformation": "^5.31.7",
    "tiktok-live-connector": "^2.1.1-beta1",
    "ws": "^8.21.0",
    "youtube-search-api": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1"
  }
}